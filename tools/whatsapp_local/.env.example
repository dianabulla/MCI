DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASS=
DB_NAME=mcimadrid

# Tiempo máximo de conexión a MySQL en ms
DB_CONNECT_TIMEOUT_MS=15000

# SSL para MySQL remoto (Hostinger puede requerirlo según plan)
# disabled | required
DB_SSL_MODE=disabled
# true valida certificado CA; false evita bloqueo por CA en entornos compartidos
DB_SSL_REJECT_UNAUTHORIZED=false

# Opcional: para sesiones separadas por ambiente
WA_CLIENT_ID=mcimadrid_server

# true para servidor (sin UI), false para debug local con navegador visible
WA_HEADLESS=true

# Número de mensajes por lote
WA_BATCH_LIMIT=20

# Pausa aleatoria entre mensajes en ms (1 a 3 minutos por defecto; para pruebas usa 10000–30000)
WA_DELAY_MIN_MS=60000
WA_DELAY_MAX_MS=180000

# No marcar "enviado" en BD hasta ACK de WhatsApp (evita envíos fantasma)
WA_WAIT_ACK=1
# Cumpleaños: dejar en 0 (la API a veces da ACK_ERROR aunque el mensaje sí llega, como en envío manual)
WA_WAIT_ACK_CUMPLEANOS=0
WA_WAIT_ACK_MS=90000
WA_MIN_ACK=1
WA_ACK_ERROR_GRACE_MS=12000
WA_CUMPLE_TYPING_MS=2000

# Cumpleaños: 1 = no adjuntar imagen (útil si ACK_ERROR con la plantilla multimedia)
# WA_SKIP_MEDIA_CUMPLEANOS=1
# Compatibilidad: si defines WA_DELAY_MS se usa ese valor fijo para min y max
# WA_DELAY_MS=120000

# Intervalo de polling de cola en ms
WA_POLL_MS=5000

# Intentos máximos por mensaje antes de marcar fallido
WA_MAX_ATTEMPTS=3

# Solo procesar pendientes del día actual (Colombia vía time_zone MySQL). 0 = ventana WA_QUEUE_MAX_AGE_DAYS
WA_ONLY_TODAY=1
WA_QUEUE_MAX_AGE_DAYS=45
